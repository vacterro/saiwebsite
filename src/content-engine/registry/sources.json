      "note": "Delivered roadmap milestones."
    },
    {
      "id": "site.scenarios",
      "kind": "curated",
      "authority": "site",
      "canonicalLocation": "local",
      "paths": ["src/data/scenarios.ts"],
      "adapter": "file",
      "refresh": null,
