{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "saipen.protocol.registry",
      "kind": "snapshot",
      "authority": "upstream",
      "canonicalLocation": "https://github.com/vacterro/saipen/blob/main/saipen/REGISTRY.json",
      "paths": ["src/data/canonical/registry.json"],
      "adapter": "canonical",
      "refresh": "npm run canonical:sync",
      "validator": "npm run validate:canonical",
      "network": "sync-only",
      "failurePolicy": "keep-last-valid",
      "note": "Snapshot of saipen/REGISTRY.json: phases, STATE shape, commands, error codes, limits."
    },
    {
      "id": "saipen.protocol.state-schema",
      "kind": "snapshot",
      "authority": "upstream",
      "canonicalLocation": "https://github.com/vacterro/saipen/blob/main/extensions/schemas/state.schema.json",
      "paths": ["src/data/canonical/stateSchema.json"],
      "adapter": "canonical",
      "refresh": "npm run canonical:sync",
      "validator": "npm run validate:canonical",
      "network": "sync-only",
      "failurePolicy": "keep-last-valid",
      "note": "Snapshot of extensions/schemas/state.schema.json."
    },
    {
      "id": "saipen.protocol.adapters",
      "kind": "snapshot",
      "authority": "upstream",
      "canonicalLocation": "https://github.com/vacterro/saipen/blob/main/extensions/adapters/registry.json",
      "paths": ["src/data/canonical/adapters.json"],
      "adapter": "canonical",
      "refresh": "npm run canonical:sync",
      "validator": "npm run validate:canonical",
      "network": "sync-only",
      "failurePolicy": "keep-last-valid",
      "note": "Snapshot of extensions/adapters/registry.json: hosts and declared enforcement."
    },
    {
      "id": "saipen.protocol.meta",
      "kind": "snapshot",
      "authority": "upstream",
      "canonicalLocation": "https://github.com/vacterro/saipen/blob/main/VERSION",
      "paths": ["src/data/canonical/meta.json"],
      "adapter": "canonical",
      "refresh": "npm run canonical:sync",
      "validator": "npm run validate:canonical",
      "network": "sync-only",
      "failurePolicy": "keep-last-valid",
      "note": "Identity of the canonical snapshot: SAIPEN version, commit, per-file SHA-256."
    },
    {
      "id": "saipen.hq.project-map",
      "kind": "curated",
      "authority": "site",
      "canonicalLocation": "https://github.com/saipenhq/.github/blob/main/docs/PROJECTS.md",
      "paths": ["src/data/ecosystem.ts"],
      "adapter": "file",
      "refresh": null,
      "validator": null,
      "network": "none",
      "failurePolicy": "fail-closed",
      "note": "Curated ecosystem catalogue after the SAIPEN HQ project map."
    },
    {
      "id": "github.vacterro.releases",
      "kind": "snapshot",
      "authority": "upstream",
      "canonicalLocation": "https://api.github.com/users/vacterro/repos",
      "paths": ["src/data/ecosystem.snapshot.json"],
      "adapter": "ecosystem",
      "refresh": "npm run ecosystem:sync",
      "validator": null,
      "network": "sync-only",
      "failurePolicy": "keep-last-valid",
      "note": "GitHub facts of the curated projects: descriptions, latest releases, asset digests."
    },
    {
      "id": "vacterro.support.public",
      "kind": "curated",
      "authority": "site",
      "canonicalLocation": "local",
      "paths": ["src/data/support.ts"],
      "adapter": "file",
      "refresh": null,
      "validator": "npm run test:support",
      "network": "none",
      "failurePolicy": "fail-closed",
      "note": "Public voluntary-support details shown on /pricing/."
