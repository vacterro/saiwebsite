---
/**
 * Documentation layout (WINTAGE_WEB_CONTRACT §17, MASTER_ROADMAP M5).
 *
 *   +----------+-----------------------------+------------+
 *   | CONTENTS | Title, maturity, authority  | ON THIS    |
 *   | tree     | document                    | PAGE       |
 *   |          | sources, previous / next    |            |
 *   +----------+-----------------------------+------------+
 *
 * Below 1000px the right column moves above the document as a <details>;
 * below 820px the contents tree does the same. Both are native disclosures:
 * keyboard operable, no script, nothing floats over the text.
 *
 * Every page states its maturity and authority level and links the canonical
 * SAIPEN sources it rests on, pinned to the snapshot commit — the website is
 * never a second source of protocol truth (MASTER_ROADMAP §4).
 */
import MaturityBadge from '../components/MaturityBadge.astro';
import SiteLayout from './SiteLayout.astro';
import DocsTree from '../components/DocsTree.astro';
import { SHORT_COMMIT, sourceUrl } from '../content-engine/models/protocol';
import { CANONICAL_LOCALE, translator } from '../content-engine/i18n/catalog';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PagerLink {
  href: string;
  title: string;
}

interface Props {
  /** Locale of the page; chrome strings and tree titles follow it. */
  locale?: string;
  title: string;
  description: string;
  /** The current doc's id, for aria-current in the tree. */
  current?: string;
  section?: string;
  sectionHref?: string;
  headings?: Heading[];
  maturity?: 'draft' | 'preview' | 'stable';
  authority?: 'reference' | 'engineering' | 'explanation';
  sources?: { path: string; anchor?: string; label: string }[];
  prev?: PagerLink;
  next?: PagerLink;
  /** On a translated page: the English original, which stays authoritative. */
  original?: string;
}

const { locale = CANONICAL_LOCALE, title, description, current, section, sectionHref, headings = [], maturity, authority, sources = [], prev, next, original } =
  Astro.props;
const tx = translator(locale);
// Heading text includes the trailing "#" anchor link added by rehype-wintage.
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#$/, '') }));

const authorityNote = authority ? tx.text(`docs-ui.authority.${authority}`) : '';

const crumbs = [
  { label: tx.text('ui.crumbs.home'), href: tx.href('/') },
  { label: tx.text('pages.docs.index.label'), href: tx.href('/docs/') },
  ...(section ? [{ label: section, href: sectionHref }] : []),
  { label: title },
];
---

<SiteLayout locale={locale} title={title} tag="/docs/" description={description} crumbs={current ? crumbs : undefined} ogType="article">
  <div class="docs">
    <nav class="tree docs__tree" aria-label={tx.text('docs-ui.tree.label')}>
      <p class="tree__title" set:html={tx.html('docs-ui.tree.title')}></p>
      <DocsTree current={current} idPrefix="tree" locale={locale} />
    </nav>

    <details class="w-panel w-panel--sunken docs__tree-compact">
      <summary set:html={tx.html('docs-ui.tree.label')}></summary>
      <nav class="tree" aria-label={tx.text('docs-ui.tree.label')}>
        <DocsTree current={current} idPrefix="tree-compact" locale={locale} />
      </nav>
    </details>

    <article class="prose docs__article">
      <h1>{title}</h1>
      {
        (maturity || authority) && (
          <div class="docs__meta">
            {maturity && <MaturityBadge level={maturity} />}
            {authority && <span class="w-panel__note">{authorityNote}</span>}
          </div>
        )
      }

      {
        toc.length > 2 && (
          <details class="docs__toc-inline">
            <summary set:html={tx.html('docs-ui.toc.title')}></summary>
            <ul class="plain">
              {toc.map((h) => (
                <li class={`toc__item toc__item--${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      {
        original && (
          <p class="w-panel__note docs__translation">
            <Fragment set:html={tx.html('docs-ui.translation.note')} /> <a href={original} hreflang={CANONICAL_LOCALE} lang={CANONICAL_LOCALE}>{original}</a>
          </p>
        )
      }

      <div class="docs__body">
        <slot />
      </div>

      {
        sources.length > 0 && (
          <section class="w-panel w-panel--sunken docs__sources" aria-labelledby="sources-title">
            <h2 class="w-panel__title" id="sources-title" set:html={tx.html('docs-ui.sources.title')}></h2>
            <ul lang={tx.canonical ? undefined : CANONICAL_LOCALE}>
              {sources.map((source) => (
                <li>
                  <a href={sourceUrl(source.path, source.anchor)} rel="noopener" data-external>
                    {source.label}
                  </a>{' '}
                  <span class="w-panel__note">{source.path} @ {SHORT_COMMIT}</span>
                </li>
              ))}
            </ul>
            <p class="w-panel__note" set:html={tx.html('docs-ui.sources.note')}></p>
          </section>
        )
      }

      {
        (prev || next) && (
          <nav class="docs__pager" aria-label={tx.text('docs-ui.pager.label')}>
            {prev ? (
              <a class="w-button docs__pager-prev" href={prev.href} rel="prev">
                <span class="docs__pager-dir" set:html={tx.html('docs-ui.pager.prev')}></span>
                <span>{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="w-button docs__pager-next" href={next.href} rel="next">
                <span class="docs__pager-dir" set:html={tx.html('docs-ui.pager.next')}></span>
                <span>{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 2 && (
        <aside class="docs__toc" aria-labelledby="toc-title">
          <p class="tree__title" id="toc-title" set:html={tx.html('docs-ui.toc.title')}></p>
          <ul class="plain">
            {toc.map((h) => (
              <li class={`toc__item toc__item--${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</SiteLayout>
