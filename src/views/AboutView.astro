---
/**
 * About: who builds SAIPEN and why, how the work is done, the builder
 * principles behind it, and the engineering contract this site holds itself
 * to (MASTER_ROADMAP M14-M17, M25).
 *
 * Author facts are limited to what the author publishes on GitHub (profile
 * README, SAIPEN README and GUIDE); no biography, location or credentials are
 * invented. The dogfooding section is read from this repository's own
 * .saipen/ files at build time. Words come from the `about` block catalogue;
 * ticket titles, gate commands and model data stay canonical.
 */
import MaturityBadge from '../components/MaturityBadge.astro';
import PixelMark from '../components/PixelMark.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../data/site';
import { ECOSYSTEM_SNAPSHOT, PROJECTS } from '../content-engine/models/ecosystem';
import { LAST_VERIFICATION } from '../data/verification';
import { SHORT_COMMIT, meta } from '../content-engine/models/protocol';
import { readSelfState } from '../lib/selfstate';
import { escapeHtml } from '../content-engine/blocks/blocks.mjs';
import { translator } from '../content-engine/i18n/catalog';

interface Props {
  locale?: string;
}

const tx = translator(Astro.props.locale);
const en = tx.canonical ? undefined : 'en';

const self = readSelfState();
const done = self?.tickets.filter((t) => t.section === 'DONE') ?? [];

const GATES = [
  ['npm run build', 'about.gates.build'],
  ['npm run check', 'about.gates.check'],
  ['npm run lint', 'about.gates.lint'],
  ['npm run validate:themes', 'about.gates.validate-themes'],
  ['npm run validate:canonical', 'about.gates.validate-canonical'],
  ['npm run validate:content', 'about.gates.validate-content'],
  ['npm run validate:baselines', 'about.gates.validate-baselines'],
  ['npm run audit:build', 'about.gates.audit-build'],
  ['npm run test:pixel', 'about.gates.test-pixel'],
  ['npm run test:shell', 'about.gates.test-shell'],
  ['npm run test:content', 'about.gates.test-content'],
  ['npm run test:runtime', 'about.gates.test-runtime'],
  ['npm run test:visual', 'about.gates.test-visual'],
];

const PRINCIPLES = ['local-first', 'no-account', 'open-core', 'independence', 'visible-state', 'evidence', 'degrade', 'automate', 'control'];

const OPERATOR_TOOLS = PROJECTS.filter((p) => ['ZAICODE', 'AUDAPACK', 'SAIPAL', 'SAICONT', 'LIMISAW'].includes(p.name));
const toolList = OPERATOR_TOOLS.map(
  (p, i) =>
    `${i > 0 ? escapeHtml(i === OPERATOR_TOOLS.length - 1 ? tx.text('about.workflow.and') : tx.text('about.workflow.comma')) : ''}<a href="${tx.href(`/ecosystem/#${p.name.toLowerCase()}`)}">${escapeHtml(p.name)}</a>`,
).join('');
const WORKFLOW = ['idea', 'target', 'agent', 'verify', 'audit', 'handoff', 'next'];
---

<SiteLayout
  locale={tx.locale}
  title={tx.text('about.title')}
  tag="/about/"
  description={tx.text('about.description')}
>
  <h1 set:html={tx.html('about.title')}></h1>
  <p><MaturityBadge level="stable" /></p>
  <PixelMark name="saipen-banner-332" width={332} height={120} label="SAIPEN" class="about__banner" />

  <aside class="callout callout--authority about__motto">
    <p class="callout__label" set:html={tx.html('about.motto.label')}></p>
    <p set:html={tx.html('about.motto.body')}></p>
  </aside>

  <h2 id="author" set:html={tx.html('about.author.title')}></h2>
  <p set:html={tx.html('about.author.body1', { author: SITE.author })} />
  <p set:html={tx.html('about.author.body2', { organization: SITE.organization, community: SITE.community })} />

  <h2 id="why" set:html={tx.html('about.why.title')}></h2>
  <p set:html={tx.html('about.why.body1')}></p>
  <p set:html={tx.html('about.why.body2')}></p>
  <blockquote><p set:html={tx.html('about.why.quote')}></p></blockquote>
  <p set:html={tx.html('about.why.body3')}></p>

  <h2 id="workflow" set:html={tx.html('about.workflow.title')}></h2>
  <ol class="plain flow">
    {WORKFLOW.map((key) => <li set:html={tx.html(`about.workflow.${key}`)} />)}
  </ol>
  <p set:html={tx.html('about.workflow.tools', {}, { tools: toolList })} />

  <h2 id="principles" set:html={tx.html('about.principles.title')}></h2>
  <p class="w-panel__note" set:html={tx.html('about.principles.note')} />
  <dl class="doclist">
    {
      PRINCIPLES.map((key) => (
        <>
          <dt set:html={tx.html(`about.principles.${key}.name`)}></dt>
          <dd set:html={tx.html(`about.principles.${key}.line`)}></dd>
        </>
      ))
    }
  </dl>

  <h2 id="dogfooding" set:html={tx.html('about.dogfooding.title')}></h2>
  <p set:html={tx.html('about.dogfooding.body')} />
  {
    self ? (
      <>
        <dl class="diag">
          <dt set:html={tx.html('about.dogfooding.events')}></dt>
          <dd set:html={tx.html('about.dogfooding.events-value', { count: self.events })}></dd>
          <dt set:html={tx.html('about.dogfooding.closed')}></dt>
          <dd set:html={tx.html('about.dogfooding.closed-value', { done: done.length, total: self.tickets.length })}></dd>
          <dt set:html={tx.html('about.dogfooding.last')}></dt>
          <dd>
            <Fragment set:html={tx.html('about.dogfooding.last-value', { version: LAST_VERIFICATION.siteVersion, date: LAST_VERIFICATION.date, pages: LAST_VERIFICATION.pages, checks: LAST_VERIFICATION.browserChecks, gates: LAST_VERIFICATION.staticGates.length })} />
          </dd>
        </dl>
        <div class="wide-scroll">
          <table class="w-table">
            <thead>
              <tr>
                <th scope="col" set:html={tx.html('about.dogfooding.col.ticket')}></th>
                <th scope="col" set:html={tx.html('about.dogfooding.col.work')}></th>
                <th scope="col" set:html={tx.html('about.dogfooding.col.state')}></th>
              </tr>
            </thead>
            <tbody lang={en}>
              {self.tickets.map((t) => (
                <tr>
                  <th scope="row">{t.id}</th>
                  <td>{t.title}</td>
                  <td>
                    {t.section.toLowerCase()}
                    {t.closure && <span class="w-panel__note"> ({t.closure})</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p set:html={tx.html('about.dogfooding.red')}></p>
        <ul lang={en}>
          {LAST_VERIFICATION.redControls.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </>
    ) : (
      <p class="w-panel__note" set:html={tx.html('about.dogfooding.none')}></p>
    )
  }

  <h2 id="scope" set:html={tx.html('about.scope.title')}></h2>
  <p set:html={tx.html('about.scope.body')}></p>
  <ul>
    <li set:html={tx.html('about.scope.not-protocol', { repository: SITE.repository! })} />
    <li set:html={tx.html('about.scope.not-engine')} />
    <li set:html={tx.html('about.scope.authority')} />
  </ul>

  <h2 id="beyond" set:html={tx.html('about.beyond.title')}></h2>
  <p set:html={tx.html('about.beyond.body', { author: ECOSYSTEM_SNAPSHOT.author })} />

  <h2 id="design" set:html={tx.html('about.design.title')}></h2>
  <p set:html={tx.html('about.design.body')} />

  <h2 id="accessibility" set:html={tx.html('about.a11y.title')}></h2>
  <ul>
    <li set:html={tx.html('about.a11y.landmarks')} />
    <li set:html={tx.html('about.a11y.focus')}></li>
    <li set:html={tx.html('about.a11y.nojs')}></li>
    <li set:html={tx.html('about.a11y.colour')}></li>
    <li set:html={tx.html('about.a11y.text')}></li>
    <li set:html={tx.html('about.a11y.motion')}></li>
  </ul>

  <h2 id="performance" set:html={tx.html('about.perf.title')}></h2>
  <p set:html={tx.html('about.perf.body')} />

  <h2 id="quality-gates" set:html={tx.html('about.gates.title')}></h2>
  <div class="wide-scroll">
    <table class="w-table">
      <thead>
        <tr><th scope="col" set:html={tx.html('about.gates.col.command')}></th><th scope="col" set:html={tx.html('about.gates.col.fails')}></th></tr>
      </thead>
      <tbody>
        {
          GATES.map(([cmd, id]) => (
            <tr>
              <th scope="row"><code>{cmd}</code></th>
              <td set:html={tx.html(id)}></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="deployment" set:html={tx.html('about.deploy.title')}></h2>
  <ul>
    <li set:html={tx.html('about.deploy.static')}></li>
    <li set:html={tx.html('about.deploy.links', { domain: SITE.domain })}></li>
    <li set:html={tx.html('about.deploy.generated')} />
    <li set:html={tx.html('about.deploy.aliases')} />
  </ul>
  <p set:html={tx.html('about.deploy.status')} />

  <h2 id="sources" set:html={tx.html('about.sources.title')}></h2>
  <dl class="diag">
    <dt set:html={tx.html('about.sources.protocol')}></dt>
    <dd set:html={tx.html('about.sources.protocol-value', { version: meta.version, commit: SHORT_COMMIT })}></dd>
    <dt set:html={tx.html('about.sources.ecosystem')}></dt>
    <dd set:html={tx.html('about.sources.ecosystem-value', { date: ECOSYSTEM_SNAPSHOT.date })}></dd>
    <dt set:html={tx.html('about.sources.design')}></dt>
    <dd set:html={tx.html('about.sources.design-value')}></dd>
  </dl>
</SiteLayout>
