---
/**
 * Search (MASTER_ROADMAP M13). The form is a plain GET form, so the query is a
 * shareable URL. Results are computed in the browser from a static index:
 * the locale's own index when the locale has search enabled, the canonical
 * one otherwise. Without JavaScript the page says so and offers the
 * documentation index. Ctrl+K / Cmd+K anywhere on the site jumps here.
 *
 * The script is one bundle for every locale: the words it writes and the
 * index it reads are handed over in data attributes, never branched on.
 */
import MaturityBadge from '../components/MaturityBadge.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { CANONICAL_LOCALE, localeOf, localePrefix, translator } from '../content-engine/i18n/catalog';

interface Props {
  locale?: string;
}

const tx = translator(Astro.props.locale);
const l = localeOf(tx.locale);
const index = tx.locale !== CANONICAL_LOCALE && l.searchEnabled ? `/${localePrefix(tx.locale)}/search-index.json` : '/search-index.json';
const words = {
  searching: tx.text('search.status.searching'),
  prompt: tx.text('search.status.prompt'),
  one: tx.text('search.status.one', { query: '{query}' }),
  many: tx.text('search.status.many', { count: '{count}', query: '{query}' }),
  none: tx.text('search.status.none', { query: '{query}' }),
  error: tx.text('search.status.error'),
};
---

<SiteLayout locale={tx.locale} title={tx.text('search.title')} tag="/search/" description={tx.text('search.description')}>
  <h1 set:html={tx.html('search.title')}></h1>
  <p><MaturityBadge level="stable" note={tx.text('search.badge-note')} /></p>
  <form class="search" action={tx.href('/search/')} method="get" role="search" data-index={index} data-words={JSON.stringify(words)}>
    <label class="w-field__label" for="q" set:html={tx.html('search.field.label')}></label>
    <div class="row">
      <input class="w-input search__input" id="q" name="q" type="search" autocomplete="off" />
      <button class="w-button w-button--primary" type="submit" set:html={tx.html('search.field.submit')}></button>
    </div>
    <p class="w-field__help" set:html={tx.html('search.field.help')}></p>
  </form>

  <p class="search__status" data-status aria-live="polite" set:html={tx.html('search.status.nojs')} />
  <ol class="plain search__results" data-results></ol>
</SiteLayout>

<script>
  type Entry = { url: string; title: string; kind: string; rank: number; text: string };

  const params = new URLSearchParams(location.search);
  const query = (params.get('q') ?? '').trim();
  const form = document.querySelector<HTMLFormElement>('form.search');
  const input = document.querySelector<HTMLInputElement>('#q');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const list = document.querySelector<HTMLOListElement>('[data-results]');
  const words: Record<string, string> = JSON.parse(form?.dataset.words ?? '{}');
  const say = (key: string, vars: Record<string, string | number> = {}) =>
    (words[key] ?? '').replace(/\{(\w+)\}/g, (_m, name) => String(vars[name] ?? ''));

  if (input) input.value = query;
  if (status) status.textContent = query ? say('searching') : say('prompt');

  const score = (entry: Entry, terms: string[]) => {
    const title = entry.title.toLowerCase();
    const text = entry.text.toLowerCase();
    let total = 0;
    for (const term of terms) {
      const t = title.includes(term) ? 10 : 0;
      const b = text.includes(term) ? 2 : 0;
      if (!t && !b) return 0;
      total += t + b;
    }
    return total * entry.rank;
  };

  const snippet = (text: string, term: string) => {
    const at = text.toLowerCase().indexOf(term);
    if (at < 0) return text.slice(0, 160);
    const start = Math.max(0, at - 60);
    return `${start > 0 ? '…' : ''}${text.slice(start, start + 180)}…`;
  };

  if (query && list && status) {
    fetch(form?.dataset.index ?? '/search-index.json')
      .then((r) => r.json())
      .then((entries: Entry[]) => {
        const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
        const hits = entries
          .map((e) => ({ e, s: score(e, terms) }))
          .filter((h) => h.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 40);
        status.textContent = hits.length
          ? say(hits.length === 1 ? 'one' : 'many', { count: hits.length, query })
          : say('none', { query });
        for (const { e } of hits) {
          const li = document.createElement('li');
          li.className = 'search__hit';
          const a = document.createElement('a');
          a.href = e.url;
          a.textContent = e.title;
          const kind = document.createElement('span');
          kind.className = 'w-panel__note';
          kind.textContent = ` ${e.kind}`;
          const p = document.createElement('p');
          p.className = 'search__snippet';
          p.textContent = snippet(e.text, terms[0]);
          li.append(a, kind, p);
          list.append(li);
        }
      })
      .catch(() => {
        status.textContent = say('error');
      });
  }
</script>
