---
/**
 * 404 (MASTER_ROADMAP M25). Static hosts serve /404.html for unknown paths.
 * The message says what happened and offers the next useful step — never
 * "something went wrong" (UI.md, logs and diagnostics). Words come from the
 * `notfound` block catalogue, so every locale has its own 404.
 */
import PixelMark from '../components/PixelMark.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { translator } from '../content-engine/i18n/catalog';

interface Props {
  locale?: string;
}

const tx = translator(Astro.props.locale);
---

<SiteLayout locale={tx.locale} title={tx.text('notfound.title')} tag="404" description={tx.text('notfound.description')} noindex crumbs={[{ label: tx.text('ui.crumbs.home'), href: tx.href('/') }, { label: tx.text('notfound.crumb') }]}>
  <h1 set:html={tx.html('notfound.title')}></h1>
  <div class="w-panel w-panel--sunken with-mark">
    <PixelMark name="saipen-emblem-64" width={64} height={64} tone="dim" />
    <div>
    <h2 class="w-panel__title" set:html={tx.html('notfound.panel.title')}></h2>
    <p set:html={tx.html('notfound.panel.body')} />
    <div class="row">
      <a class="w-button w-button--primary" href={tx.href('/')} set:html={tx.html('notfound.action.home')}></a>
      <a class="w-button" href={tx.href('/docs/')} set:html={tx.html('notfound.action.docs')}></a>
      <a class="w-button" href={tx.href('/search/')} set:html={tx.html('notfound.action.search')}></a>
    </div>
    </div>
  </div>
</SiteLayout>
