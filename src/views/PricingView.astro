---
/**
 * Pricing (MASTER_ROADMAP M22, §9; FUTURE_GATES FG-007, FG-009). Words come
 * from the `pricing` block catalogue; support details are data and stay as
 * the canonical source states them.
 *
 * Core contract:
 * Protocol, docs, spec, ecosystem tools, and local/self-hosted use are completely free.
 * No hosted service, no paid plan, and no fake SaaS tier exists.
 *
 * Support is optional:
 * Canonical support details are sourced from src/data/support.ts (matching
 * https://github.com/vacterro/vacterro/blob/main/SUPPORT.md).
 */
import MaturityBadge from '../components/MaturityBadge.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE } from '../data/site';
import { SUPPORT } from '../content-engine/models/support';
import { translator } from '../content-engine/i18n/catalog';

interface Props {
  locale?: string;
}

const tx = translator(Astro.props.locale);
const en = tx.canonical ? undefined : 'en';
---

<SiteLayout
  locale={tx.locale}
  title={tx.text('pricing.title')}
  tag="/pricing/"
  description={tx.text('pricing.description')}
>
  <h1 set:html={tx.html('pricing.title')}></h1>
  <p><MaturityBadge level="stable" note={tx.text('pricing.badge-note')} /></p>

  <div class="wide-scroll">
    <table class="w-table">
      <thead>
        <tr>
          <th scope="col" set:html={tx.html('pricing.col.offering')}></th>
          <th scope="col" set:html={tx.html('pricing.col.state')}></th>
          <th scope="col" set:html={tx.html('pricing.col.today')}></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" set:html={tx.html('pricing.protocol.name')}></th>
          <td><span class="w-badge w-badge--ok" set:html={tx.html('pricing.state.free')}></span></td>
          <td set:html={tx.html('pricing.protocol.today', { repository: SITE.repository! })} />
        </tr>
        <tr>
          <th scope="row" set:html={tx.html('pricing.local.name')}></th>
          <td><span class="w-badge w-badge--ok" set:html={tx.html('pricing.state.free')}></span></td>
          <td set:html={tx.html('pricing.local.today')}></td>
        </tr>
        <tr>
          <th scope="row" set:html={tx.html('pricing.tools.name')}></th>
          <td><span class="w-badge w-badge--ok" set:html={tx.html('pricing.state.free')}></span></td>
          <td set:html={tx.html('pricing.tools.today')} />
        </tr>
        <tr>
          <th scope="row" set:html={tx.html('pricing.hosted.name')}></th>
          <td><span class="w-badge w-badge--info" set:html={tx.html('pricing.state.none')}></span></td>
          <td set:html={tx.html('pricing.hosted.today')}></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 set:html={tx.html('pricing.future.title')}></h2>
  <p set:html={tx.html('pricing.future.body')}></p>

  <section class="support-section" aria-labelledby="support-heading">
    <h2 id="support-heading" set:html={tx.html('pricing.support.title')}></h2>
    <p set:html={tx.html('pricing.support.body')}></p>

    <h3 set:html={tx.html('pricing.support.direct')}></h3>
    <div class="row">
      {SUPPORT.easy.map((item) => (
        <a class="w-button" href={item.url} rel="noopener" data-external>{item.name}</a>
      ))}
    </div>

    <h3 set:html={tx.html('pricing.support.bank-title')}></h3>
    <div class="w-panel">
      <div class="w-panel__title">LHV (EUR)</div>
      <div class="wide-scroll">
        <table class="w-table bank-table">
          <tbody>
            <tr>
              <th scope="row" class="bank-label-col" set:html={tx.html('pricing.support.bank')}></th>
              <td>{SUPPORT.bank.bank}</td>
            </tr>
            <tr>
              <th scope="row" class="bank-label-col" set:html={tx.html('pricing.support.recipient')}></th>
              <td>{SUPPORT.bank.recipient}</td>
            </tr>
            <tr>
              <th scope="row" class="bank-label-col">IBAN</th>
              <td>
                <div class="iban-row">
                  <code class="support-code">{SUPPORT.bank.iban}</code>
                  <button type="button" class="w-button w-button--small js-copy" data-copy={SUPPORT.bank.iban} data-copied={tx.text('pricing.support.copied')} lang={tx.langOf('pricing.support.copy')}>{tx.text('pricing.support.copy')}</button>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <h3 set:html={tx.html('pricing.support.crypto-title')}></h3>
    <p class="w-panel__note safety-note" lang={en}>
      {SUPPORT.warning}
    </p>

    <div class="crypto-grid">
      {SUPPORT.crypto.map((c) => (
        <div class="w-panel crypto-card">
          <div class="crypto-header">
            <span class="crypto-name">{c.name}</span>
            <span class="w-badge">{c.network}</span>
          </div>
          <div class="crypto-meta">
            <span class="crypto-label" set:html={tx.html('pricing.support.network-label')}></span> {c.accepted}
          </div>
          <div class="crypto-address-row">
            <code class="crypto-address">{c.address}</code>
            <button type="button" class="w-button w-button--small js-copy" data-copy={c.address} data-copied={tx.text('pricing.support.copied')} lang={tx.langOf('pricing.support.copy')}>{tx.text('pricing.support.copy')}</button>
          </div>
        </div>
      ))}
    </div>

    <p class="w-panel__note source-note" set:html={tx.html('pricing.support.source', { source: SUPPORT.source })} />
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.js-copy').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy');
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const original = button.textContent;
          button.textContent = button.getAttribute('data-copied') ?? original;
          setTimeout(() => {
            button.textContent = original;
          }, 1500);
        } catch {
          // Fallback if clipboard API is unavailable; address remains selectable in DOM
        }
      });
    });
  </script>
</SiteLayout>

<style>
  .support-section {
    margin-top: var(--gap-6);
  }
  .bank-label-col {
    width: 120px;
  }
  .bank-table {
    margin-top: var(--gap-3);
  }
  .iban-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-3);
  }
  .safety-note {
    margin-bottom: var(--gap-4);
  }
  .source-note {
    margin-top: var(--gap-5);
  }
  .crypto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-4);
  }
  .crypto-card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3);
  }
  .crypto-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-3);
  }
  .crypto-name {
    font-size: var(--size-body);
    font-family: var(--face-body);
    line-height: var(--lh-body);
    font-weight: var(--weight-bold);
  }
  .crypto-meta {
    font-size: var(--size-meta);
    font-family: var(--face-meta);
    line-height: var(--lh-meta);
    color: var(--ui-text-dim);
  }
  .crypto-label {
    color: var(--ui-text);
    font-weight: var(--weight-bold);
  }
  .crypto-address-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-3);
    background-color: var(--ui-window);
    padding: var(--gap-2) var(--gap-3);
    border: 1px solid var(--ui-edge-muted);
  }
  .support-code {
    font-family: var(--face-code);
    font-size: var(--size-body);
    line-height: var(--lh-code);
    user-select: all;
  }
  .crypto-address {
    font-family: var(--face-code);
    font-size: var(--size-body);
    line-height: var(--lh-code);
    word-break: break-all;
    user-select: all;
  }
</style>
