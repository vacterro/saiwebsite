---
/** /about/ in every routed locale (content-system M47). */
import AboutView from '../../../views/AboutView.astro';
import { PLAN } from '../../../content-engine/i18n/catalog';

export function getStaticPaths() {
  return PLAN.filter((p) => p.pages.some((x) => x.pageId === 'about')).map((p) => ({ params: { locale: p.prefix }, props: { locale: p.locale } }));
}

const { locale } = Astro.props;
---

<AboutView locale={locale} />
