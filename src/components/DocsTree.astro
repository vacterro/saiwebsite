---
/**
 * The documentation contents tree. Rendered twice by DocsLayout: once as the
 * desktop side column, once inside a compact disclosure for narrow screens.
 * CSS shows exactly one, so only one contents landmark is ever exposed.
 */
import { docHref, docTree } from '../lib/docs';
import { CANONICAL_LOCALE, docMeta, translator } from '../content-engine/i18n/catalog';

interface Props {
  current?: string;
  idPrefix: string;
  locale?: string;
}

const { current, idPrefix, locale = CANONICAL_LOCALE } = Astro.props;
const tx = translator(locale);
const tree = await docTree();
---

<form class="tree__search" action={tx.href('/search/')} method="get" role="search">
  <label class="tree__search-label" for={`${idPrefix}-search`} set:html={tx.html('docs-ui.tree.search')}></label>
  <input class="w-input" id={`${idPrefix}-search`} name="q" type="search" autocomplete="off" />
</form>
{
  tree.map((group) => (
    <div class="tree__group">
      <p class="tree__group-title" set:html={tx.html(`docs-ui.section.${group.section}`)}></p>
      <ul>
        {group.docs.map((doc) => {
          const meta = docMeta(doc.id, locale);
          return (
            <li>
              <a href={tx.href(docHref(doc))} aria-current={doc.id === current ? 'page' : undefined} lang={meta.lang === locale ? undefined : meta.lang}>
                {meta.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))
}
<div class="tree__group">
  <p class="tree__group-title" set:html={tx.html('docs-ui.tree.spec')}></p>
  <ul>
    <li><a href="/spec/" set:html={tx.html('docs-ui.tree.spec-index')}></a></li>
    <li><a href="/spec/v8/lifecycle/" set:html={tx.html('docs-ui.tree.state-machine')}></a></li>
  </ul>
</div>
