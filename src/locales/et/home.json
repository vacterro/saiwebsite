    "home.hero.lead": {
      "text": "SAIPEN hoiab projekti töömälu projekti sees lihtfailides, nii et ühilduv agent — ilma vestlusajaloo ja ilma seansi mäluta — saab ühe käsuga jätkata kirja pandud olekust. Protokoll määrab üleandmise; kui usaldusväärselt konkreetne agent seda järgib, sõltub agendist, keskkonnast ja käituskeskkonnast.",
      "sourceHash": "1d2c8b96a1d7fb87",
      "status": "MACHINE_DRAFT",
      "author": "codex:T-20"
    },
