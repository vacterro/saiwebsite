# SAIPEN runtime namespace (machine-local; never release source) -- T-1435.
# Durable protocol/evidence history (.saipen/evidence, archive, intake,
# recovery/log-detail, recovery/board-compaction, recovery/conformance,
# recovery/log-normalize, recovery/log-foreign-tail, extensions) stays
# versioned; only the mechanics below are excluded.
.saipen/locks/
.saipen/cache/
.saipen/recovery/ops/
.saipen/snapshots/

# Build output and dependencies
node_modules/
dist/
.astro/

# Playwright run artefacts. tests/baselines/ is versioned on purpose: the
# screenshots ARE the visual regression reference.
test-results/
playwright-report/

# Supplied source archives (reference material, not project source)
_src_unpack/
_packs_tmp/
_local_ref/
*.zip
___*.png

# OS noise
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]


# Translation work packages (npm run i18n:export); scratch, never committed.
i18n-work/

# Freebuff desktop agent workspace (tool-local identity, not project source).
.freebuff/

# Transient operator-operation lock. Never protocol memory or release content.
.site-work/

# Disposable clean-checkout reproduction / fixture worktrees. These belong in
# os.tmpdir(), never the project root; the literal "%TEMP%" directory is an
# unexpanded Windows token a tool wrote verbatim. Ignored so a stray repro tree
# can never re-enter the audited root unnoticed.
/%TEMP%/
sai-clean-repro-*/
sai-site-fixture-*/
sai-phaseE-*/

# Vite dependency cache (astro.config.mjs cacheDir); build output, never source.
.vite-cache/

# Content-layer data store (regression-pair driver cacheDir); sandbox scratch.
.build-cache/
