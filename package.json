{
  "name": "sai-website",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "SAIPEN Protocol public web surface — Wintage-native static site.",
  "scripts": {
    "dev": "astro dev",
    "fonts:build": "python scripts/fonts/build_pixel_fonts.py --out public/fonts",
    "fonts:compare": "python scripts/fonts/compare_reference.py",
    "fonts:reference": "python scripts/fonts/build_reference_fonts.py",
    "fonts:coverage": "python scripts/fonts/coverage.py",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "canonical:sync": "node scripts/sync-canonical.mjs",
    "validate:canonical": "node scripts/validate-canonical.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "registry:inventory": "node scripts/site.mjs refresh",
    "site:doctor": "node scripts/site.mjs doctor",
    "site:impact": "node scripts/site.mjs impact",
    "site:refresh": "node scripts/site.mjs refresh",
    "site:sync": "node scripts/site.mjs sync",
    "site:drift": "node scripts/site.mjs drift",
    "site:affected": "node scripts/site.mjs affected",
    "i18n:status": "node scripts/i18n.mjs status",
    "i18n:export": "node scripts/i18n.mjs export",
    "i18n:import": "node scripts/i18n.mjs import",
    "i18n:validate": "node scripts/i18n.mjs validate",
    "i18n:memory": "node scripts/i18n.mjs memory",
    "i18n:add": "node scripts/i18n.mjs add",
    "i18n:enable": "node scripts/i18n.mjs enable",
    "validate:baselines": "node scripts/validate-baselines.mjs",
    "validate:licenses": "node scripts/validate-licenses.mjs",
    "lint": "node scripts/lint-styles.mjs",
    "validate:themes": "node scripts/validate-themes.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "test:runtime": "playwright test tests/theme-runtime.spec.mjs --project=chromium",
    "test:shell": "playwright test tests/site-shell.spec.mjs --project=chromium",
    "test:content": "playwright test tests/content-features.spec.mjs --project=chromium",
    "test:support": "playwright test tests/support.spec.mjs --project=chromium",
    "test:i18n": "playwright test tests/i18n.spec.mjs --project=chromium",
    "test:pixel": "playwright test tests/pixel-perfect.spec.mjs",
    "test:visual": "playwright test tests/visual-baseline.spec.mjs --project=chromium",
    "test:visual:update": "playwright test tests/visual-baseline.spec.mjs --project=chromium --update-snapshots && node scripts/validate-baselines.mjs --write",
    "test": "playwright test",
    "social:build": "python scripts/social/make_card.py --out public/social/card.png",
    "media:build": "python scripts/media/build_media.py",
    "ecosystem:sync": "node scripts/sync-ecosystem.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.11",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
